<Window x:Class="PersonalBATranscriber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalBATranscriber.App.ViewModels"
        mc:Ignorable="d"
        Title="Personal BA Audio Transcriber - Windows 11" 
        Height="820" Width="1240"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Calibri">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Styling Tokens -->
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0284C7" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Budget Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Media Player Transport -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Workspace (Editor + Glossary) -->
            <RowDefinition Height="*" />
            <!-- 3: Status & Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hidden MediaElement for audio playback -->
        <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" />

        <!-- 0: HEADER & BUDGET BAR -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎙️ Personal BA Transcriber" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    <Border Background="#E0F2FE" CornerRadius="12" Margin="14,0,0,0" Padding="10,3">
                        <TextBlock Text="Windows 11 Native" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" />
                    </Border>
                </StackPanel>

                <!-- Groq API Key Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Groq API Key:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B" FontSize="12" />
                    <PasswordBox x:Name="ApiKeyBox" Width="220" Padding="8,4" VerticalAlignment="Center" PasswordChar="•" 
                                 BorderBrush="#CBD5E1" PasswordChanged="ApiKeyBox_PasswordChanged" />
                    <Button Content="Save Key" Command="{Binding SaveApiKeyCommand}" Margin="6,0,0,0" Padding="8,4" FontSize="12" />
                </StackPanel>

                <!-- Live Monthly Budget Ledger Widget -->
                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="16" Padding="12,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Monthly Spend: " FontWeight="Normal" Foreground="#166534" FontSize="12" />
                        <TextBlock Text="{Binding BudgetDisplay}" FontWeight="Bold" Foreground="#15803D" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 1: MEDIA PLAYER CONTROLS -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- File Import & Play Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁 Open Recording..." Command="{Binding SelectMediaFileCommand}" Margin="0,0,12,0" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" />
                    <Button Content="⏮ 5s" Command="{Binding SkipBackwardCommand}" Margin="0,0,6,0" Width="48" ToolTip="Skip Backward 5 Seconds" />
                    <Button x:Name="PlayPauseBtn" Content="▶ Play" Command="{Binding TogglePlayPauseCommand}" Margin="0,0,6,0" Width="68" Background="#F1F5F9" FontWeight="Bold" />
                    <Button Content="5s ⏭" Command="{Binding SkipForwardCommand}" Margin="0,0,16,0" Width="48" ToolTip="Skip Forward 5 Seconds" />
                </StackPanel>

                <!-- Timeline Slider & Time Labels -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentPosition, StringFormat=\{0:hh\\:mm\\:ss\}}" 
                               Foreground="#64748B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" x:Name="TimelineSlider" VerticalAlignment="Center" Minimum="0" 
                            Maximum="{Binding TotalDurationSeconds}" 
                            Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                            ValueChanged="TimelineSlider_ValueChanged" />
                    <TextBlock Grid.Column="2" Text="{Binding TotalDuration, StringFormat=\{0:hh\\:mm\\:ss\}}" 
                               Foreground="#64748B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <!-- Start Transcription Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Transcribe with Groq" Command="{Binding StartTranscriptionCommand}" 
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Background="#059669" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" FontWeight="Bold" />
                    <Button Content="✕ Cancel" Command="{Binding CancelProcessingCommand}" 
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" 
                            Margin="8,0,0,0" Background="#DC2626" Foreground="#FFFFFF" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: MAIN WORKSPACE (Transcript Editor + Glossary) -->
        <Grid Grid.Row="2" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <!-- Left: Editor (75%) -->
                <ColumnDefinition Width="3*" />
                <!-- Splitter -->
                <ColumnDefinition Width="12" />
                <!-- Right: Glossary & Stats (25%) -->
                <ColumnDefinition Width="1*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: TRANSCRIPT EDITOR -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Editor Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Cleaned English Transcript (Click sentence to play audio)" 
                                   FontWeight="Bold" FontSize="13" Foreground="#334155" />
                        <TextBlock Text="{Binding Sentences.Count, StringFormat=\{0\} sentences}" 
                                   HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="12" />
                    </Grid>

                    <!-- Sentence Review List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sentences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" 
                                            CornerRadius="6" Margin="0,0,0,8" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Timestamp Button -->
                                            <Button Grid.Column="0" Content="{Binding FormattedTimestamp, StringFormat=[{0}]}" 
                                                    Command="{Binding DataContext.PlaySentenceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="#F1F5F9" Foreground="#0284C7" BorderThickness="0" 
                                                    FontWeight="Bold" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Top" />

                                            <!-- Editable Sentence Text -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SpeakerLabel}" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding UserEditedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue={Binding CleanedText}}"
                                                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap" 
                                                         FontSize="13" Foreground="#0F172A" />
                                            </StackPanel>

                                            <!-- Direct Play Icon -->
                                            <Button Grid.Column="2" Content="▶" 
                                                    Command="{Binding DataContext.PlaySentenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#0284C7" 
                                                    VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Play Sentence Audio" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT: DOMAIN GLOSSARY PANEL -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Project Glossary" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Text="Biases recognition of domain terms" FontSize="11" Foreground="#94A3B8" Margin="0,20,0,8" />

                    <!-- Add Term Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewTermText, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="6" BorderBrush="#CBD5E1" FontSize="12" />
                        <Button Grid.Column="1" Content="+ Add" Command="{Binding AddGlossaryTermCommand}" Margin="6,0,0,0" Padding="10,6" FontSize="12" />
                    </Grid>

                    <!-- Terms List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GlossaryTerms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4" Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TermText}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="✕" 
                                                    Command="{Binding DataContext.RemoveGlossaryTermCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="4,0" FontSize="10" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3: STATUS & ACTION BAR -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message & Progress Bar -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="12" />
                    <ProgressBar Height="4" Margin="0,4,30,0" Value="{Binding ProgressValue}" Maximum="1.0" 
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" 
                                 Foreground="#0284C7" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Save Project (.taproj)" Command="{Binding SaveProjectCommand}" Margin="0,0,10,0" Padding="12,6" />
                    <Button Content="📄 Export Word (.docx)" Command="{Binding ExportToWordCommand}" 
                            Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="14,6" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
