<Window x:Class="PersonalBATranscriber.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings &amp; API Keys"
        Height="560" Width="520"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Calibri">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚙️ Application Settings" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Configure cloud credentials and transcription budget controls."
                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form Fields (scrollable so nothing can push the Save/Cancel buttons off-window) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <!-- Groq API Key Section -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Groq Cloud API Key" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                        <TextBlock Text="Used for ultra-fast Whisper Large-v3 speech recognition &amp; translation."
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,10" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Padding="10,6" BorderBrush="#CBD5E1" FontSize="13" PasswordChar="•" />
                            <Button x:Name="ToggleVisibilityBtn" Grid.Column="1" Content="👁" Margin="6,0,0,0" Padding="10,6"
                                    Click="ToggleVisibilityBtn_Click" ToolTip="Show/Hide Key" />
                        </Grid>
                        <TextBox x:Name="ApiKeyTextBox" Padding="10,6" BorderBrush="#CBD5E1" FontSize="13" Visibility="Collapsed" />

                        <!-- Helper link -->
                        <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Don't have a key? Get one free in 1 minute at " Foreground="#64748B" />
                            <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_RequestNavigate">
                                console.groq.com/keys
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Offline Engine Section -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="💻 Offline Speech Engine (faster-whisper)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                        <TextBlock Text="Runs 100% offline on your Intel CPU. Zero internet or API key required."
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" Margin="0,4,6,0">
                                <TextBlock Text="Engine: CTranslate2 INT8" FontSize="11" Foreground="#475569" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" Margin="0,4,6,0">
                                <TextBlock Text="Hardware: CPU (4 Threads)" FontSize="11" Foreground="#475569" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" Margin="0,4,0,0">
                                <TextBlock Text="Status: Ready (Models Cached)" FontSize="11" Foreground="#166534" FontWeight="Bold" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Budget Controls Section -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monthly Budget Ceiling" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                            <TextBlock Text="Hard-stop threshold to prevent unexpected cloud spend."
                                       FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="8,0,0,0">
                            <TextBlock Text="$20.00 / month" FontWeight="Bold" Foreground="#15803D" FontSize="13" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions (always pinned to the bottom of the window) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Padding="16,8" Background="#F1F5F9" BorderBrush="#CBD5E1" />
            <Button Content="Save Settings" Click="Save_Click" Padding="18,8" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
