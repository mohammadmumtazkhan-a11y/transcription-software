<Window x:Class="PersonalBATranscriber.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings &amp; API Keys" 
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Calibri">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚙️ Application Settings" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Configure cloud credentials and transcription budget controls." 
                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1">
            <!-- Groq API Key Section -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Groq Cloud API Key" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                    <TextBlock Text="Used for ultra-fast Whisper Large-v3 speech recognition &amp; translation." 
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox" Padding="10,6" BorderBrush="#CBD5E1" FontSize="13" PasswordChar="•" />
                        <Button x:Name="ToggleVisibilityBtn" Grid.Column="1" Content="👁" Margin="6,0,0,0" Padding="10,6" 
                                Click="ToggleVisibilityBtn_Click" ToolTip="Show/Hide Key" />
                    </Grid>
                    <TextBox x:Name="ApiKeyTextBox" Padding="10,6" BorderBrush="#CBD5E1" FontSize="13" Visibility="Collapsed" />

                    <!-- Helper link -->
                    <TextBlock FontSize="11" Margin="0,4,0,0">
                        <Run Text="Don't have a key? Get one free in 1 minute at " Foreground="#64748B" />
                        <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_RequestNavigate">
                            console.groq.com/keys
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Budget Controls Section -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Monthly Budget Ceiling" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                        <TextBlock Text="Hard-stop threshold to prevent unexpected cloud spend." 
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <TextBlock Text="$20.00 / month" FontWeight="Bold" Foreground="#15803D" FontSize="13" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" Padding="16,8" Background="#F1F5F9" BorderBrush="#CBD5E1" />
            <Button Content="Save Settings" Click="Save_Click" Padding="18,8" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
